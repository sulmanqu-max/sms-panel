<!DOCTYPE html>
<html lang="ur" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMS Panel System - sms-panel.com</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                            accent: '#00f2fe',
                            neon: '#38ef7d'
                        },
                        darkbg: '#0B0F19',
                        cardbg: '#111827',
                        borderbg: '#1F2937'
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 2s infinite',
                        'gradient-x': 'gradientX 3s ease infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%, 100%': { boxShadow: '0 0 15px rgba(79, 70, 229, 0.4)' },
                            '50%': { boxShadow: '0 0 30px rgba(0, 242, 254, 0.8)' }
                        },
                        gradientX: {
                            '0%, 100%': { 'background-size': '200% 200%', 'background-position': 'left center' },
                            '50%': { 'background-size': '200% 200%', 'background-position': 'right center' }
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0B0F19;
            color: #F3F4F6;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #111827;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4B5563;
        }
        .animated-btn {
            background: linear-gradient(90deg, #4f46e5, #00f2fe, #38ef7d, #4f46e5);
            background-size: 300% 100%;
            transition: all 0.4s ease-in-out;
        }
        .animated-btn:hover {
            background-position: 100% 0;
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.6);
            transform: translateY(-1px);
        }
        .glass-panel {
            background: rgba(17, 24, 39, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-darkbg text-gray-100 antialiased selection:bg-brand-500 selection:text-white">

    <!-- Toast Notification Box -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- Application Shell -->
    <div id="app" class="min-h-screen flex flex-col w-full">
        
        <!-- ================= LOGIN SCREEN ================= -->
        <section id="login-screen" class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden bg-gradient-to-br from-darkbg via-cardbg to-black">
            <!-- Decorative Glow BG -->
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-600/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute bottom-1/4 right-10 w-80 h-80 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="w-full max-w-md glass-panel p-8 rounded-2xl shadow-2xl relative z-10 border border-gray-800">
                <!-- Logo & Header -->
                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-brand-600 to-brand-accent text-white mb-4 shadow-lg shadow-brand-500/30">
                        <i class="fa-solid fa-paper-plane text-2xl"></i>
                    </div>
                    <h1 class="text-2xl font-bold tracking-tight text-white">SMS Panel System</h1>
                    <p class="text-xs text-brand-accent font-medium mt-1 tracking-wider uppercase">sms-panel.com</p>
                    <p class="text-sm text-gray-400 mt-2">Sign in to manage numbers, clients & OTPs</p>
                </div>

                <!-- Alert Message -->
                <div id="login-error" class="hidden mb-4 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span id="login-error-text">Invalid credentials</span>
                </div>

                <!-- Form -->
                <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Username</label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                            <input type="text" id="login-username" required placeholder="Enter username (e.g. Salman)" 
                                class="w-full bg-gray-900/90 border border-gray-700 rounded-xl py-3 pl-10 pr-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Password</label>
                        <div class="relative">
                            <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                            <input type="password" id="login-password" required placeholder="••••••••" 
                                class="w-full bg-gray-900/90 border border-gray-700 rounded-xl py-3 pl-10 pr-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all">
                        </div>
                    </div>

                    <!-- 4-Digit Captcha Integration -->
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Bot Protection Captcha</label>
                        <div class="flex items-center gap-3">
                            <div class="relative flex-1">
                                <i class="fa-solid fa-shield-halved absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                                <input type="text" id="login-captcha-input" required maxlength="4" placeholder="Enter 4-digits" 
                                    class="w-full bg-gray-900/90 border border-gray-700 rounded-xl py-3 pl-10 pr-4 text-sm text-white font-mono placeholder-gray-500 focus:outline-none focus:border-brand-500 transition-all">
                            </div>
                            <div class="flex items-center gap-2 bg-gradient-to-r from-gray-900 to-black px-4 py-2.5 rounded-xl border border-gray-700/80 shadow-inner select-none">
                                <span id="captcha-code" class="text-xl font-extrabold tracking-widest text-brand-accent font-mono italic">8492</span>
                                <button type="button" onclick="generateCaptcha()" class="text-gray-400 hover:text-white transition ml-1" title="Refresh Captcha">
                                    <i class="fa-solid fa-rotate text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Animated Login Button -->
                    <button type="submit" id="btn-login" 
                        class="animated-btn w-full py-3.5 px-6 rounded-xl text-white font-semibold text-sm shadow-lg tracking-wide flex items-center justify-center gap-2 cursor-pointer mt-4">
                        <span>Login to Dashboard</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>

                <!-- Footer Hint -->
                <div class="mt-6 pt-5 border-t border-gray-800/80 text-center text-xs text-gray-500 flex flex-col gap-1">
                    <p>Admin Default: <span class="text-brand-accent font-mono font-medium">Salman</span> | Pass: <span class="text-brand-accent font-mono font-medium">Salman12</span></p>
                    <p class="text-[10px] text-gray-400">Security: 4-Digit Captcha Bot Protection Enabled.</p>
                </div>
            </div>
        </section>

        <!-- ================= MAIN DASHBOARD SHELL ================= -->
        <section id="dashboard-screen" class="hidden min-h-screen flex flex-col md:flex-row bg-darkbg">
            
            <!-- Sidebar -->
            <aside class="w-full md:w-64 bg-cardbg border-r border-gray-800 flex-shrink-0 flex flex-col justify-between">
                <div>
                    <!-- Brand Banner -->
                    <div class="p-5 border-b border-gray-800 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-accent flex items-center justify-center text-white shadow-md">
                            <i class="fa-solid fa-paper-plane text-lg"></i>
                        </div>
                        <div>
                            <h2 class="font-bold text-white text-base leading-tight">SMS Panel</h2>
                            <span class="text-[11px] text-brand-accent font-semibold tracking-wide">sms-panel.com</span>
                        </div>
                    </div>

                    <!-- User Info Badge -->
                    <div class="p-4 mx-3 my-3 rounded-xl bg-gray-900/80 border border-gray-800 flex items-center gap-3">
                        <div id="user-avatar" class="w-9 h-9 rounded-full bg-brand-600 text-white flex items-center justify-center font-bold text-sm">
                            S
                        </div>
                        <div class="overflow-hidden">
                            <p id="user-display-name" class="text-sm font-semibold text-white truncate">Salman</p>
                            <span id="user-role-badge" class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-brand-500/20 text-brand-accent border border-brand-500/30">
                                ADMIN
                            </span>
                        </div>
                    </div>

                    <!-- Navigation Links -->
                    <nav class="px-3 space-y-1">
                        <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-white bg-brand-600/20 border border-brand-500/30 transition">
                            <i class="fa-solid fa-chart-pie text-brand-accent w-5"></i>
                            <span>Dashboard & Stats</span>
                        </button>

                        <button onclick="switchTab('get-numbers')" id="nav-get-numbers" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800/60 transition">
                            <i class="fa-solid fa-sim-card w-5"></i>
                            <span>Get Numbers & Range</span>
                        </button>

                        <button onclick="switchTab('api-sync')" id="nav-api-sync" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800/60 transition">
                            <i class="fa-solid fa-plug w-5"></i>
                            <span>Live API Integration</span>
                        </button>

                        <!-- Admin Only Links -->
                        <div id="admin-nav-section" class="pt-4 mt-4 border-t border-gray-800">
                            <p class="px-4 text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-2">Admin Controls</p>
                            
                            <button onclick="switchTab('client-mgmt')" id="nav-client-mgmt" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800/60 transition">
                                <i class="fa-solid fa-users-gear w-5 text-brand-500"></i>
                                <span>Client Management</span>
                            </button>

                            <button onclick="switchTab('number-mgmt')" id="nav-number-mgmt" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800/60 transition">
                                <i class="fa-solid fa-layer-group w-5 text-brand-500"></i>
                                <span>Manage Ranges & Numbers</span>
                            </button>
                        </div>
                    </nav>
                </div>

                <!-- Logout Button -->
                <div class="p-4 border-t border-gray-800">
                    <button onclick="logout()" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold text-red-400 hover:bg-red-500/10 border border-red-500/20 transition">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Sign Out</span>
                    </button>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
                
                <!-- Top Navbar Header -->
                <header class="bg-cardbg/80 backdrop-blur-md border-b border-gray-800 p-4 sticky top-0 z-20 flex items-center justify-between">
                    <div>
                        <h1 id="page-title" class="text-lg font-bold text-white">Dashboard Overview</h1>
                        <p id="page-subtitle" class="text-xs text-gray-400">Live ODP counters & panel activity metrics</p>
                    </div>

                    <!-- Right Controls -->
                    <div class="flex items-center gap-3">
                        <!-- Live Sync Indicator Badge -->
                        <div class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-3 py-1.5 rounded-full text-xs font-medium">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                            <span>System Online</span>
                        </div>

                        <!-- Add Quick Action Button (Admin Only) -->
                        <button id="btn-quick-action" onclick="openAddNumberModal()" class="hidden sm:flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow transition">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Numbers</span>
                        </button>
                    </div>
                </header>

                <!-- Content Panels -->
                <div class="p-4 md:p-6 space-y-6">

                    <!-- ================= TAB 1: DASHBOARD & COUNTERS ================= -->
                    <div id="tab-dashboard" class="tab-content space-y-6">
                        
                        <!-- Top ODP Time counters -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <!-- Day ODP Card -->
                            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group border border-brand-500/20">
                                <div class="absolute -right-4 -bottom-4 text-brand-500/10 text-7xl font-black group-hover:scale-110 transition">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                </div>
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Day ODPs (Today)</span>
                                    <span class="p-2 rounded-xl bg-brand-500/20 text-brand-accent text-xs">
                                        <i class="fa-solid fa-calendar-day"></i>
                                    </span>
                                </div>
                                <h3 id="stat-day-odp" class="text-3xl font-extrabold text-white tracking-tight">142</h3>
                                <p class="text-xs text-emerald-400 mt-2 flex items-center gap-1">
                                    <i class="fa-solid fa-arrow-trend-up"></i>
                                    <span>+18% from yesterday</span>
                                </p>
                            </div>

                            <!-- Week ODP Card -->
                            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group border border-purple-500/20">
                                <div class="absolute -right-4 -bottom-4 text-purple-500/10 text-7xl font-black group-hover:scale-110 transition">
                                    <i class="fa-solid fa-calendar-week"></i>
                                </div>
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Week ODPs</span>
                                    <span class="p-2 rounded-xl bg-purple-500/20 text-purple-400 text-xs">
                                        <i class="fa-solid fa-chart-line"></i>
                                    </span>
                                </div>
                                <h3 id="stat-week-odp" class="text-3xl font-extrabold text-white tracking-tight">984</h3>
                                <p class="text-xs text-gray-400 mt-2">Current week accumulated</p>
                            </div>

                            <!-- Month ODP Card -->
                            <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group border border-emerald-500/20">
                                <div class="absolute -right-4 -bottom-4 text-emerald-500/10 text-7xl font-black group-hover:scale-110 transition">
                                    <i class="fa-solid fa-calendar-days"></i>
                                </div>
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Month ODPs</span>
                                    <span class="p-2 rounded-xl bg-emerald-500/20 text-emerald-400 text-xs">
                                        <i class="fa-solid fa-award"></i>
              
